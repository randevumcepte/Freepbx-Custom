# === Asterisk ARI (FreePBX 16) ===
# KARAR: asistan SANTRAL sunucusunda (Asterisk ile ayni makine) calisir -> her sey LOKAL.
# ARI, RTP, Whisper, Ollama, TTS hepsi 127.0.0.1. Media icin firewall GEREKMEZ.
ARI_URL=http://127.0.0.1:8088
ARI_USER=sidecar
ARI_PASS=BURAYA_SIDECAR_PAROLASI
# dialplan'daki Stasis(randevu_ai,...) ile BIREBIR ayni olmali. `ari show apps` ile dogrula.
ARI_APP=randevu_ai

# External Media: Asterisk sesi bu host:port'a RTP (slin16, 16kHz) GONDERIR.
# Ayni makinede oldugumuz icin 127.0.0.1. (Ayri sunucuda olsaydi bu sunucunun IP'si olurdu.)
EXTERNAL_MEDIA_HOST=127.0.0.1
EXTERNAL_MEDIA_PORT=5001

# === BEYIN MOTORU ===
# ollama = UCRETSIZ, kendi sunucunuzda (Qwen). claude = Anthropic API (ucretli).
BRAIN=ollama

# === Ollama (ucretsiz / yerel) ===
OLLAMA_URL=http://127.0.0.1:11434
# GPU varsa: qwen2.5:14b | orta: qwen2.5:7b | CPU-only: qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b

# === Claude (yalnizca BRAIN=claude ise) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# === STT (dinleme) ===
# whisper = UCRETSIZ yerel (faster-whisper via whisper_server.py). google = ucretli.
STT_ENGINE=whisper
STT_LANGUAGE=tr-TR
WHISPER_URL=http://127.0.0.1:5003
# GPU: medium/large-v3 | CPU: small/base/tiny
WHISPER_MODEL=small
# VAD (konusma bitisi) — telefon sesine gore ayarla
VAD_SILENCE_MS=800
VAD_RMS=500
VAD_MAX_MS=12000
# google kullanilirsa: GOOGLE_APPLICATION_CREDENTIALS=/path/gcloud-key.json

# === Laravel randevu API ===
API_BASE=https://app.randevumcepte.com.tr

# === TTS (konusma) ===
# edge = UCRETSIZ (Edge-TTS, internet gerekir) | piper = UCRETSIZ offline | polly = ucretli
TTS_ENGINE=edge
EDGE_TTS_VOICE=tr-TR-EmelNeural
# PIPER_MODEL=/opt/piper/tr_TR-model.onnx
TTS_OUT_DIR=/var/spool/asterisk/monitor
