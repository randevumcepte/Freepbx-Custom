# === Asterisk ARI (FreePBX 16) ===
# SIDECAR mimari: AI bu (Laravel) sunucuda calisir, Asterisk AYRI sunucuda.
# ARI_URL = ASTERISK(SANTRAL) sunucusunun IP'si. (Ayni makinede ise 127.0.0.1)
ARI_URL=http://SANTRAL_IP:8088
# FreePBX'te hazir ARI kullanicisi (ari_additional.conf/[sidecar]).
ARI_USER=sidecar
ARI_PASS=BURAYA_SIDECAR_PAROLASI
# dialplan'daki Stasis(randevu_ai,...) ile BIREBIR ayni olmali. `ari show apps` ile dogrula.
ARI_APP=randevu_ai

# External Media: Asterisk sesi bu host:port'a RTP (slin16, 16kHz) GONDERIR.
# Bu yuzden EXTERNAL_MEDIA_HOST = BU (sidecar/Laravel) sunucunun, Asterisk'in
# erisebildigi IP'si olmali (127.0.0.1 DEGIL, iki ayri sunucu ise). Node RTP burayi dinler.
EXTERNAL_MEDIA_HOST=SIDECAR_LARAVEL_IP
EXTERNAL_MEDIA_PORT=5001

# === BEYIN MOTORU ===
# ollama = UCRETSIZ, kendi sunucunuzda (Qwen). claude = Anthropic API (ucretli).
BRAIN=ollama

# === Ollama (ucretsiz / yerel) ===
OLLAMA_URL=http://127.0.0.1:11434
# GPU varsa: qwen2.5:14b | orta: qwen2.5:7b | CPU-only: qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b

# === Claude (yalnizca BRAIN=claude ise) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# === Google Cloud Speech (streaming STT) ===
# Servis hesabi JSON yolu
GOOGLE_APPLICATION_CREDENTIALS=/var/lib/asterisk/agi-bin/randevu-ai/gcloud-key.json
STT_LANGUAGE=tr-TR

# === Laravel randevu API ===
API_BASE=https://app.randevumcepte.com.tr

# === TTS ===
# tts motoru: "polly" (mevcut /opt/aws-nodejs/polly.js ile ayni) veya "google"
TTS_ENGINE=polly
# Uretilen ses dosyalarinin Asterisk'in okuyabildigi dizin (ARI Playback icin)
TTS_OUT_DIR=/var/spool/asterisk/monitor
